# Identidad de la financiera
RFC_INSTITUCION=XXXX000000XXX
URL_BASE=https://api.financiera.mx/pui
CLAVE_PUI_LOGIN=FinancieraLogin1!
CLAVE_WEBHOOK=Financiera2026!Secure1
CLAVE_BIOMETRICOS=base64_encoded_32_byte_key_here

# PUI
PUI_BASE_URL=https://www.api.plataformadebusqueda.gob.mx/api/2_3_0
PUI_ORIGIN=https://www.api.plataformadebusqueda.gob.mx

# JWT
JWT_SECRET=min_32_chars_webhook_secret_here_!!
JWT_EXPIRATION_SECONDS=3600

# Panel JWT
PANEL_JWT_SECRET=min_32_chars_panel_secret_here_!!!!
PANEL_JWT_EXPIRATION_SECONDS=28800
PANEL_ORIGIN=https://panel.financiera.mx

# Base de datos
DATABASE_URL=postgresql://pui_user:pui_pass@postgres:5432/pui_integration

# Redis
REDIS_URL=redis://redis:6379

# Scheduler
BUSQUEDA_CONTINUA_CRON=0 * * * *

# TLS
TLS_CERT_PATH=/certs/cert.pem
TLS_KEY_PATH=/certs/key.pem

# App
PORT=3000
# Para demos/pruebas: development (TypeORM crea las tablas automáticamente).
# Para producción: production (requiere migraciones generadas en src/migrations/).
NODE_ENV=development
